{
  "name": "@roster-lock/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Roster Lock: Cloudflare-hosted living-roster contracts, match-making, and a marketplace",
  "workspaces": [
    "shared/*",
    "living-roster",
    "living-roster/*",
    "match-making",
    "match-making/*",
    "marketplace/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
